# Client-safe Supabase project values. Never put a service-role key in VITE_* variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only AI credentials
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account"}

# Server-only Supabase values used by the atomic AI quota. Never expose the
# service-role key through a VITE_* variable.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional server-side CoinGecko key. Public API access works without it.
COINGECKO_API_KEY=

# Server-only Telegram bot integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
