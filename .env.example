# Firebase web app config: Firebase Console > Project settings > Your apps.
# These values identify the web app; never put service-account keys in VITE_*.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Server verification: the same project ID as VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=

# Local user migration only: path to a Firebase admin service-account JSON.
# Keep the file outside git, e.g. .migration-secrets/firebase-admin.json.
# Do not add this credential to the frontend or ordinary deployment config.
GOOGLE_APPLICATION_CREDENTIALS=

# Server-only AI credentials
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account"}

# Turnstile protects website AI generation. Public build config:
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFSFBv33VMh4DpXy
# Private server secret from the SAME existing widget (Cloudflare and Vercel).
TURNSTILE_SECRET=
# Exact frontend hostnames accepted by this backend, without scheme or port.
# Production must not include localhost, 127.0.0.1, or development hosts.
TURNSTILE_HOSTNAMES=blocklens.corstack.dev
# Local development only: use an allowed development hostname instead.
# TURNSTILE_HOSTNAMES=localhost

# Server-only Neon connection for account data and the atomic AI quota.
DATABASE_URL=postgresql://owner:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct connection for migration scripts, never passed to the browser.
DATABASE_URL_UNPOOLED=postgresql://owner:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# One-time import source; never set this in a frontend or deployment environment.
SUPABASE_DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?sslmode=require

# Optional server-side CoinGecko key. Public API access works without it.
COINGECKO_API_KEY=

# Server-only Telegram bot integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
