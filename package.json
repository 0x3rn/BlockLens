{
  "name": "blocklens",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.16.0",
    "firebase": "^12.19.0",
    "google-auth-library": "^11.0.2",
    "jose": "^6.2.12",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.14.0",
    "openai": "^7.8.0",
    "pg": "^8.23.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.8.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gemini-search": "node --env-file=.env.local scripts/gemini-google-search-test.mjs",
    "test:gemini-grounding": "node --env-file=.env.local scripts/gemini-grounding-benchmark.mjs",
    "telegram:commands": "node --env-file=.env.local scripts/configure-telegram-commands.mjs",
    "preview": "vite preview",
    "db:check": "node --env-file=.env.local scripts/neon-migrate.mjs",
    "db:migrate": "node --env-file=.env.local scripts/neon-migrate.mjs --apply",
    "db:verify": "node --env-file=.env.local scripts/neon-verify.mjs",
    "auth:verify": "node --env-file=.env.local scripts/firebase-verify.mjs",
    "db:import": "node --env-file=.env.local scripts/neon-import.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
